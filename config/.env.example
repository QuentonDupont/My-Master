# Copy to .env (gitignored). Never commit real values.

# --- Jira ---
JIRA_BASE_URL=https://pomelofashion.atlassian.net
JIRA_EMAIL=you@pomelofashion.com
JIRA_API_TOKEN=

# --- Requester intake sheet ---
# v1 reads a CSV export of the intake sheet. No Google API integration yet.
REQUESTER_SHEET_CSV=corpus/raw/intake_sheet.csv

# --- Optional: LLM analyst for the Jira workers ---
# Unset -> workers fall back to the deterministic heuristic analyst.
ANTHROPIC_API_KEY=
# Sonnet is the default: the failures it has to fix are keyword
# matches with no comprehension, not subtle reasoning errors, and it
# is 2.5x cheaper on a job that runs every five minutes.
ANALYST_MODEL=claude-sonnet-5

# --- Optional: GitHub (read-only evidence for the Historian) ---
GITHUB_TOKEN=

# --- Daily status email (agents/chief_of_staff/daily_report.py) ---
REPORT_EMAIL_FROM=
# Defaults to REPORT_EMAIL_FROM if unset.
REPORT_EMAIL_TO=

# Preferred auth: OAuth2, no 2-Step Verification required. Run
# `python3 tools/gmail_oauth_setup.py` once — it fills these in for you.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Alternative auth: an App Password. Needs 2-Step Verification turned on
# first (myaccount.google.com/apppasswords) — skip this if that's not wanted.
REPORT_EMAIL_APP_PASSWORD=

# --- Runtime ---
LOG_LEVEL=INFO
