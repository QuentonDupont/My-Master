<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pomelo.daily_report</string>

  <!-- Not a service: fires once, runs to completion, exits. StartCalendarInterval
       is a wall-clock alarm, not an interval timer: if the Mac is asleep at
       09:00 it fires as soon as it wakes, once, rather than being skipped. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-m</string>
    <string>agents.chief_of_staff.daily_report</string>
    <string>run</string>
    <string>--send</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/quenton-d/My-Master</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/quenton-d/My-Master</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <!-- Appends: each day's run is one more block in the same file, not a
       fresh log wiping yesterday's send status. -->
  <key>StandardOutPath</key>
  <string>/Users/quenton-d/My-Master/logs/daily_report.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/quenton-d/My-Master/logs/daily_report.err</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
