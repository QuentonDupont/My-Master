<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pomelo.mcp</string>

  <!-- Absolute paths: launchd has a minimal environment and no shell profile. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-m</string>
    <string>tools.mcp_server</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8766</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/quenton-d/My-Master</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/quenton-d/My-Master</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <!-- launchd captures stdout already; no need to double-log to stderr -->
    <key>LOG_STDERR</key>
    <string>0</string>
  </dict>

  <!-- Long-running: bring it back if it ever exits. -->
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>

  <!-- Binds to 127.0.0.1 only. The tunnel is what makes it reachable, so
       stopping the tunnel is enough to take it off the internet. -->
  <key>StandardOutPath</key>
  <string>/Users/quenton-d/My-Master/logs/mcp.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/quenton-d/My-Master/logs/mcp.err</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
